{
  "name": "social-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted panel for Threads + Instagram (official Meta APIs) with MCP server",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning node_modules/tsx/dist/cli.mjs src/server/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "hono": "^4.13.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
