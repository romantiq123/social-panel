# Порт API/панели
PORT=3001

# Пароль для входа в панель. Обязателен, если панель смотрит наружу через туннель.
# Если не задан — сгенерируется при первом запуске и будет выведен в консоль.
PANEL_PASSWORD=

# (необязательно) Можно задать здесь, но удобнее через UI → Настройки
# PUBLIC_BASE_URL=https://your-tunnel.example.com
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# Папка для базы и медиа. На Railway: подключите Volume с mount path /data
# DATA_DIR=/data

# Токен для удалённого MCP (/mcp). Если не задан — генерируется, смотрите в Настройках
# MCP_TOKEN=
